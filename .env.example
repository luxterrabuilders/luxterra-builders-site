# ---------------------------------------------------------------
# Luxterra Builders - environment variables
# Copy this file to .env.local for local dev, and add the same
# values in Vercel > Project > Settings > Environment Variables.
# NEVER commit .env or .env.local. Both are gitignored.
# ---------------------------------------------------------------

# Resend (https://resend.com) - transactional email for lead delivery.
# Required before the lead form can send email.
RESEND_API_KEY=

# The "from" address. The domain must be verified in Resend first.
# Example: "Luxterra Builders <leads@luxterrabuilders.com>"
LEAD_FROM_EMAIL=

# Where new leads are delivered.
LEAD_TO_EMAIL=info@luxterrabuilders.com

# Optional fallback. If Resend is not configured or fails, the server
# forwards the lead here so it is never silently lost.
# This is the existing Formspree endpoint that already reaches your inbox.
LEAD_FALLBACK_ENDPOINT=https://formspree.io/f/myzrdyba
